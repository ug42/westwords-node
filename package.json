    "test": "node --test --test-force-exit test/*.test.js",
    "art": "node scripts/build-art.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
