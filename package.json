{
  "name": "westwords-node",
  "version": "1.0.0",
  "description": "Westwords: a voice-chat social deduction word game (roles, night actions, timers, tokens, voting). Node.js port of ug42/westwords.",
  "main": "server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
